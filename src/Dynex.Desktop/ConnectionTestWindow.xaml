<Window x:Class="Dynex.Desktop.ConnectionTestWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="DYNEX · Zwei-PC-Verbindungstest" Width="740" Height="590" MinWidth="540" MinHeight="440" WindowStartupLocation="CenterOwner" Background="{DynamicResource Bg}" Foreground="#E6EAF0" FontFamily="Segoe UI">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="Verbindung gezielt prüfen" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="DYNEX muss auf beiden PCs laufen. Lokale Diagnose bis 10 Sekunden, anschließend gezielte Geräte-Probe bis 5 Sekunden. Jede Stufe zeigt ihren eigenen Befund." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,7,0,14"/></StackPanel>
  <ComboBox x:Name="TargetBox" Grid.Row="1" DisplayMemberPath="DisplayName" Margin="0,0,0,14"/>
  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="Results"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,12"><StackPanel><DockPanel><TextBlock Text="{Binding State}" DockPanel.Dock="Right" Foreground="{DynamicResource Accent}" Margin="14,0,0,0"/><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/></DockPanel><TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,5,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
  <StackPanel Grid.Row="3" Margin="0,14,0,0"><TextBlock x:Name="Feedback" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0"><Button x:Name="StartButton" Content="Test starten" Click="StartClick" Margin="0,0,10,0"/><Button x:Name="CancelButton" Content="Abbrechen" Click="CancelClick" IsEnabled="False" Margin="0,0,10,0"/><Button Content="Schließen" Click="CloseClick"/></StackPanel></StackPanel>
 </Grid>
</Window>
