<Window x:Class="Dynex.Desktop.DeviceManagerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="DYNEX · Geräte" Width="860" Height="560" MinWidth="640" MinHeight="460" WindowStartupLocation="CenterOwner" Background="{DynamicResource Bg}" Foreground="#E6EAF0" FontFamily="Segoe UI">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,16"><TextBlock Text="Geräte im Heimnetz" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Nur authentifizierte Geräte. Alias und Ausschlüsse gelten lokal auf diesem PC." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
  <DataGrid x:Name="DeviceGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionChanged="SelectionChanged" Background="{DynamicResource Panel}" Foreground="#E6EAF0" RowBackground="{DynamicResource Panel}" AlternatingRowBackground="#1A202A" BorderBrush="{DynamicResource Line}" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource Line}">
   <DataGrid.Columns><DataGridTextColumn Header="Gerät / lokaler Alias" Binding="{Binding DisplayName}" Width="*"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/><DataGridTextColumn Header="Zuletzt gesehen" Binding="{Binding LastSeenText}" Width="160"/><DataGridTextColumn Header="Adresse" Binding="{Binding Address}" Width="130"/></DataGrid.Columns>
  </DataGrid>
  <Grid Grid.Row="2" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Margin="0,0,12,0"><TextBlock Text="Lokaler Alias" Foreground="{DynamicResource Muted}"/><TextBox x:Name="AliasBox" MaxLength="80" Margin="0,6,0,0"/></StackPanel>
   <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Teilnahme" Foreground="{DynamicResource Muted}"/><ComboBox x:Name="DispositionBox" SelectedIndex="0" Margin="0,6,0,0"><ComboBoxItem Content="Zulassen"/><ComboBoxItem Content="Ignorieren"/><ComboBoxItem Content="Sperren"/></ComboBox></StackPanel>
   <Button x:Name="SaveButton" Grid.Column="2" Content="Speichern" Click="SaveClick" VerticalAlignment="Bottom" IsEnabled="False"/>
  </Grid>
  <StackPanel Grid.Row="3" Margin="0,12,0,0"><TextBlock Text="Ignorieren und Sperren schließen den Statusaustausch und die automatische Verbindung zu diesem Gerät aus. AutoLAN bleibt aktiv." Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/><TextBlock x:Name="Feedback" TextWrapping="Wrap" Foreground="{DynamicResource Accent}" Margin="0,7,0,0"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0"><Button Content="Verbindung testen" Click="TestClick" Margin="0,0,10,0"/><Button Content="Schließen" Click="CloseClick"/></StackPanel></StackPanel>
 </Grid>
</Window>
