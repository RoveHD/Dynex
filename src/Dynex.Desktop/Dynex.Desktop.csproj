<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF owns startup and per-monitor DPI; WinForms is used only for the tray icon. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <AssemblyName>DYNEX</AssemblyName>
    <Version>1.0.23</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/dynex.ico</ApplicationIcon>
    <!-- Background tray app: no extra background GC thread, smaller heap. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../Dynex.Core/Dynex.Core.csproj" /></ItemGroup>
  <ItemGroup><Resource Include="Assets/dynex.ico" /></ItemGroup>
  <ItemGroup Condition="'$(PrioritizationPayloadManifest)' != ''">
    <EmbeddedResource Include="$(PrioritizationPayloadManifest)" LogicalName="Dynex.Prioritization.Payload.json" />
  </ItemGroup>
  <ItemGroup><InternalsVisibleTo Include="Dynex.Runtime.Tests" /></ItemGroup>
  <ItemGroup><InternalsVisibleTo Include="Dynex.Service.Tests" /></ItemGroup>
</Project>
