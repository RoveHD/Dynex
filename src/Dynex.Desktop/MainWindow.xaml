        <Button x:Name="SettingsNavButton" Grid.Column="2" Click="SettingsNav_Click" Style="{StaticResource CompactButton}" Padding="10,7" Background="Transparent" BorderBrush="Transparent" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="Einstellungen öffnen" AutomationProperties.Name="Einstellungen öffnen" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="17" VerticalAlignment="Center" />
            <TextBlock Text="Einstellungen" Margin="8,0,0,0" FontSize="12" Visibility="{DynamicResource NavigationLabelVisibility}" />
          </StackPanel>
        </Button>
        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="—" Style="{StaticResource ChromeButtonStyle}" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Minimize_Click" ToolTip="Minimieren" />
          <Button x:Name="MaximizeButton" Content="□" Style="{StaticResource ChromeButtonStyle}" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Maximize_Click" ToolTip="Maximieren" />
          <Button Content="×" Style="{StaticResource ChromeCloseButtonStyle}" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="CloseToTray_Click" ToolTip="Im Hintergrund weiterlaufen lassen" />
        </StackPanel>
      </Grid>
    </Border>
    <Border Grid.Row="1" Background="#101216" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
      <Grid Margin="8,16,8,12">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel x:Name="MainNavigation">
          <Button x:Name="OverviewNavButton" Tag="" Style="{StaticResource NavButton}" Click="OverviewNav_Click" ToolTip="Übersicht" AutomationProperties.Name="Übersicht">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="22" VerticalAlignment="Center" />
              <TextBlock Text="Übersicht" Margin="10,0,0,0" Visibility="{DynamicResource NavigationLabelVisibility}" FontSize="13" />
            </StackPanel>
          </Button>
          <Button x:Name="DevicesNavButton" Tag="" Style="{StaticResource NavButton}" Click="DevicesNav_Click" ToolTip="Verbundene Geräte" AutomationProperties.Name="Verbundene Geräte">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="22" VerticalAlignment="Center" />
              <TextBlock Text="Verbundene Geräte" Margin="10,0,0,0" Visibility="{DynamicResource NavigationLabelVisibility}" FontSize="13" />
            </StackPanel>
          </Button>
          <Button x:Name="AnalysisNavButton" Tag="analysis" Style="{StaticResource NavButton}" Click="SettingsSection_Click" ToolTip="Analyse" AutomationProperties.Name="Analyse">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="22" VerticalAlignment="Center" />
              <TextBlock Text="Analyse" Margin="10,0,0,0" Visibility="{DynamicResource NavigationLabelVisibility}" FontSize="13" />
            </StackPanel>
          </Button>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,20,0,0">
          <TextBlock x:Name="SettingsMenuLabel" Text="EINSTELLUNGEN" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="16,0,0,8" Visibility="Collapsed" />
          <StackPanel x:Name="SettingsSectionsNav" Visibility="Collapsed">
            <Button x:Name="generalSectionButton" Tag="general" Style="{StaticResource NavButton}" Click="SettingsSection_Click" ToolTip="Allgemein" AutomationProperties.Name="Allgemein">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="22" VerticalAlignment="Center" />
                <TextBlock Text="Allgemein" Margin="10,0,0,0" Visibility="{DynamicResource NavigationLabelVisibility}" FontSize="13" />
              </StackPanel>
            </Button>
            <Button x:Name="gamesSectionButton" Tag="games" Style="{StaticResource NavButton}" Click="SettingsSection_Click" ToolTip="Spiele" AutomationProperties.Name="Spiele">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="22" VerticalAlignment="Center" />
                <TextBlock Text="Spiele" Margin="10,0,0,0" Visibility="{DynamicResource NavigationLabelVisibility}" FontSize="13" />
              </StackPanel>
            </Button>
            <Button x:Name="networkSectionButton" Tag="network" Style="{StaticResource NavButton}" Click="SettingsSection_Click" ToolTip="Netzwerk" AutomationProperties.Name="Netzwerk">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="22" VerticalAlignment="Center" />
                <TextBlock Text="Netzwerk" Margin="10,0,0,0" Visibility="{DynamicResource NavigationLabelVisibility}" FontSize="13" />
              </StackPanel>
            </Button>
<Button x:Name="appearanceSectionButton" Tag="appearance" Style="{StaticResource NavButton}" Click="SettingsSection_Click" ToolTip="Darstellung" AutomationProperties.Name="Darstellung">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="22" VerticalAlignment="Center" />
                <TextBlock Text="Darstellung" Margin="10,0,0,0" Visibility="{DynamicResource NavigationLabelVisibility}" FontSize="13" />
              </StackPanel>
            </Button>
            <Button x:Name="updatesSectionButton" Tag="updates" Style="{StaticResource NavButton}" Click="SettingsSection_Click" ToolTip="Updates" AutomationProperties.Name="Updates">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="22" VerticalAlignment="Center" />
                <TextBlock Text="Updates" Margin="10,0,0,0" Visibility="{DynamicResource NavigationLabelVisibility}" FontSize="13" />
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="2">
          <Border Height="1" Background="{StaticResource Line}" Margin="8,8" />
          <Button x:Name="SidebarSettingsButton" Style="{StaticResource NavButton}" Click="SettingsNav_Click" ToolTip="Einstellungen">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="22" />
              <TextBlock Text="Einstellungen" Margin="10,0,0,0" Visibility="{DynamicResource NavigationLabelVisibility}" FontSize="13" />
            </StackPanel>
          </Button>
          <TextBlock x:Name="SidebarVersionText" FontSize="10" Foreground="#737A88" Margin="16,10,0,0" Visibility="{DynamicResource NavigationLabelVisibility}" />
        </StackPanel>
      </Grid>
    </Border>
    <Grid x:Name="ContentHost" Grid.Row="1" Grid.Column="1" Margin="20,18,20,12">
      <Grid x:Name="OverviewPage">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition x:Name="MetricsRow" Height="116" />
          <RowDefinition Height="*" />
          <RowDefinition x:Name="OverviewDevicesRow" Height="190" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,20">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="260" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock x:Name="HeadlineText" Text="Netzwerkübersicht" FontSize="{DynamicResource UiHeroFontSize}" FontWeight="SemiBold" />
            <TextBlock x:Name="DetailText" Text="Dein Netzwerk wird automatisch abgestimmt." Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="ProtectionStatusText" Text="NETZWERKSCHUTZ · STATUS WIRD ERMITTELT" Style="{StaticResource Caption}" Foreground="{StaticResource Accent}" FontSize="11" Margin="0,3,0,0" />
            <Button x:Name="NetworkHelpButton" Content="Netzwerk prüfen" Click="NetworkHelp_Click" Visibility="Collapsed" Padding="8,2" Margin="0,8,0,0" FontSize="11" HorizontalAlignment="Left" />
          </StackPanel>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
            <TextBlock x:Name="QosStatusText" Text="Priorisierung wird geprüft" Foreground="{StaticResource Accent}" FontSize="11" />
            <TextBlock x:Name="QosDetailText" Text="Spiele und Sprachchat bleiben frei." Style="{StaticResource Caption}" FontSize="11" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
        <UniformGrid x:Name="StatusGrid" Grid.Row="1" Columns="4" Margin="0,0,0,16">
          <Border Style="{StaticResource Card}" Padding="10,7" Margin="0,0,8,0">
            <StackPanel>
              <TextBlock Text="DOWNLOAD · PC" Style="{StaticResource Caption}" />
              <TextBlock x:Name="DownText" Text="— Mbps" FontSize="{DynamicResource UiMetricFontSize}" FontWeight="SemiBold" Margin="0,2" />
              <TextBlock x:Name="DownCaption" Text="Gesamter Empfang" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Padding="10,7" Margin="0,0,8,0">
            <StackPanel>
              <TextBlock Text="UPLOAD · PC" Style="{StaticResource Caption}" />
              <TextBlock x:Name="UpText" Text="— Mbps" FontSize="{DynamicResource UiMetricFontSize}" FontWeight="SemiBold" Margin="0,2" />
              <TextBlock x:Name="UpCaption" Text="Gesamter Versand" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Padding="10,7" Margin="0,0,8,0">
            <StackPanel>
              <TextBlock Text="PAKETPRIORISIERUNG" Style="{StaticResource Caption}" />
              <TextBlock x:Name="PriorityOverviewText" Text="Wird geprüft" FontSize="{DynamicResource UiMetricFontSize}" FontWeight="SemiBold" Margin="0,2" />
              <TextBlock x:Name="PriorityDetailText" Text="DYNEX markiert erkannte Spiel- und Sprachpakete für QoS." Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Padding="10,7">
            <StackPanel>
              <TextBlock Text="NETZWERKSCHUTZ" Style="{StaticResource Caption}" />
              <TextBlock x:Name="DriverText" Text="WIRD GEPRÜFT" FontSize="{DynamicResource UiSectionFontSize}" FontWeight="SemiBold" Margin="0,5,0,3" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
              <TextBlock x:Name="DriverDetail" Text="Verfügbarkeit wird geprüft …" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
            </StackPanel>
          </Border>
        </UniformGrid>
        <Grid x:Name="PingLayout" Grid.Row="2" Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.7*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border x:Name="ChartPanel" Style="{StaticResource Card}" Padding="18,16" Margin="0,0,16,0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <DockPanel LastChildFill="False">
                <TextBlock Text="PING-VERLAUF" FontWeight="SemiBold" />
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}">
                  <Run Text="ROUTER" Foreground="{StaticResource Accent}" />
                  <Run Text=" / " />
                  <Run Text="INTERNET" Foreground="#E2A0A7" />
                </TextBlock>
              </DockPanel>
              <TextBlock x:Name="HistoryHoverText" Grid.Row="1" Text="Mit der Maus Zeit und Messwerte ansehen" Style="{StaticResource Caption}" Margin="0,3,0,4" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
              <Grid x:Name="HistoryPlot" Grid.Row="2" ClipToBounds="True" MinHeight="50">
                <Canvas x:Name="HistoryCanvas" Background="#0B0C10" SizeChanged="HistoryCanvas_SizeChanged" MouseMove="HistoryCanvas_MouseMove" MouseLeave="HistoryCanvas_MouseLeave" />
                <Canvas x:Name="HistoryHoverCanvas" IsHitTestVisible="False" />
              </Grid>
              <TextBlock x:Name="HistoryCompare" Grid.Row="3" Text="Noch keine Vergleichsmessungen." Style="{StaticResource Caption}" FontSize="11" Margin="0,5,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
            </Grid>
          </Border>
          <Grid Grid.Column="1">
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border x:Name="PingPanel" Style="{StaticResource Card}" Padding="18,12">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="VERBINDUNGSQUALITÄT" FontWeight="SemiBold" />
                <Grid Grid.Row="1" Margin="0,5,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                  </Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="ROUTER" Style="{StaticResource Caption}" />
                    <TextBlock x:Name="RouterPing" Text="— ms" FontSize="{DynamicResource UiMetricFontSize}" />
                    <TextBlock x:Name="RouterStats" Text="Schwankung —" Style="{StaticResource Caption}" FontSize="11" />
                    <TextBlock x:Name="RouterTarget" Text="Ziel wird ermittelt" Style="{StaticResource Caption}" FontSize="11" />
                  </StackPanel>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="INTERNET" Style="{StaticResource Caption}" />
                    <TextBlock x:Name="ExternalPing" Text="— ms" FontSize="{DynamicResource UiMetricFontSize}" />
                    <TextBlock x:Name="ExternalStats" Text="Schwankung —" Style="{StaticResource Caption}" FontSize="11" />
                    <TextBlock x:Name="ExternalTarget" Text="1.1.1.1" Style="{StaticResource Caption}" FontSize="11" />
                  </StackPanel>
                </Grid>
              </Grid>
            </Border>
            <Border x:Name="DashboardHomePanel" Grid.Row="1" Style="{StaticResource Card}" Padding="18,10" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="DEIN HEIMNETZ" FontWeight="SemiBold" />
                <TextBlock x:Name="DashboardPeersText" Text="PC-Verbindung wird geprüft." Style="{StaticResource Caption}" Margin="0,6,0,8" />
                <Button x:Name="DashboardDevicesButton" Content="Verbundene Geräte ansehen  →" Click="DevicesNav_Click" Style="{StaticResource CompactButton}" HorizontalAlignment="Left" FontSize="12" Padding="9,4" />
              </StackPanel>
            </Border>
          </Grid>
        </Grid>
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="14,9,14,7">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Margin="2,0,2,5" LastChildFill="False">
              <TextBlock Text="VERBUNDENE GERÄTE" FontWeight="SemiBold" VerticalAlignment="Center" />
              <TextBlock x:Name="OverviewDeviceCount" DockPanel.Dock="Right" Text="0 GERÄTE" Style="{StaticResource Caption}" VerticalAlignment="Center" />
            </DockPanel>
            <Grid Grid.Row="1" ClipToBounds="True">
