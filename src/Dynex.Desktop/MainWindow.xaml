    <Style x:Key="DeviceCell" TargetType="TextBlock">
     <Setter Property="FontSize" Value="{DynamicResource UiBodyFontSize}"/>
     <Setter Property="Margin" Value="9,7"/><Setter Property="TextWrapping" Value="NoWrap"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/>
     <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
    </Style>
    <Style x:Key="DeviceRateCell" TargetType="TextBlock" BasedOn="{StaticResource DeviceCell}">
     <Setter Property="TextAlignment" Value="Right"/><Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
   </DataGrid.Resources>
   <DataGrid.Columns>
    <DataGridTextColumn Header="GERÄT" Binding="{Binding Name}" Width="*" MinWidth="150" ElementStyle="{StaticResource DeviceCell}"/>
    <DataGridTextColumn Header="ADRESSE" Binding="{Binding Address}" Width="125" ElementStyle="{StaticResource DeviceCell}"/>
    <DataGridTextColumn Header="STATUS" Binding="{Binding State}" Width="105" ElementStyle="{StaticResource DeviceCell}"/>
    <DataGridTextColumn Header="↓ DOWNLOAD" Binding="{Binding DownloadMbps, StringFormat={}{0:0.0} Mbps, TargetNullValue=—}" Width="120" ElementStyle="{StaticResource DeviceRateCell}"/>
    <DataGridTextColumn Header="↑ UPLOAD" Binding="{Binding UploadMbps, StringFormat={}{0:0.0} Mbps, TargetNullValue=—}" Width="120" ElementStyle="{StaticResource DeviceRateCell}"/>
    <DataGridTextColumn Header="LIMIT" Binding="{Binding LimitMbps, StringFormat={}{0:0.0} Mbps, TargetNullValue=—}" Width="110" ElementStyle="{StaticResource DeviceCell}"/>
   </DataGrid.Columns>
  </DataGrid>
