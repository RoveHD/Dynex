                <DataGrid.Resources>
                  <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                    <Setter Property="Padding" Value="5,2" />
                    <Setter Property="ContentTemplate">
                      <Setter.Value><DataTemplate><TextBlock Text="{Binding}" FontSize="10" FontWeight="SemiBold" TextWrapping="NoWrap" /></DataTemplate></Setter.Value>
                    </Setter>
                  </Style>
                  <Style x:Key="OverviewDeviceCell" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="{DynamicResource UiSmallFontSize}" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="Margin" Value="6,1" />
                    <Setter Property="TextWrapping" Value="NoWrap" />
                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                    <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
                  </Style>
                  <Style x:Key="OverviewDeviceRateCell" TargetType="TextBlock" BasedOn="{StaticResource OverviewDeviceCell}">
