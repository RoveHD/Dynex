<Window x:Class="Dynex.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Icon="/Assets/dynex.ico" Title="DYNEX · Dynamic Network Experience" Width="1440" Height="940" MinWidth="900" MinHeight="650" Background="{StaticResource Bg}" Foreground="White" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" SnapsToDevicePixels="True"
 SizeChanged="Window_SizeChanged" SourceInitialized="Window_SourceInitialized" Closing="Window_Closing" StateChanged="Window_StateChanged">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{StaticResource Panel}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12"/></Style>
  <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontSize" Value="{DynamicResource UiSmallFontSize}"/><Setter Property="Foreground" Value="{StaticResource Muted}"/></Style>
  <Style x:Key="WrappedCheck" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></Setter.Value></Setter></Style>
  <Style x:Key="CompactButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="11,6"/></Style>
  <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Setter Property="Margin" Value="0,10,0,5"/></Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>
  <Border Background="#0C0D11" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
   <Grid Margin="18,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="200"/><ColumnDefinition Width="138"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="4" Height="28" Background="{StaticResource Accent}" Margin="0,0,12,0"/><StackPanel><TextBlock Text="DYNEX" FontSize="20" FontWeight="Bold"/><TextBlock Text="DYNAMIC NETWORK EXPERIENCE" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel></StackPanel>
    <TextBlock x:Name="HeaderState" Grid.Column="1" Text="INITIALISIERUNG" Style="{StaticResource Caption}" VerticalAlignment="Center" HorizontalAlignment="Right" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="—" Style="{StaticResource ChromeButtonStyle}" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Minimize_Click" ToolTip="Minimieren"/><Button x:Name="MaximizeButton" Content="□" Style="{StaticResource ChromeButtonStyle}" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Maximize_Click" ToolTip="Maximieren"/><Button Content="×" Style="{StaticResource ChromeCloseButtonStyle}" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="CloseToTray_Click" ToolTip="Im Hintergrund weiterlaufen lassen"/></StackPanel>
   </Grid>
  </Border>
  <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Background="#0C0D11"><StackPanel Orientation="Horizontal" Margin="18,5,0,5"><Button x:Name="OverviewNavButton" Content="Übersicht" Click="OverviewNav_Click" Style="{StaticResource CompactButton}" FontSize="14" Padding="11,4" Background="{StaticResource DeepRed}" BorderBrush="{StaticResource DeepRed}"/><Button x:Name="SettingsNavButton" Content="Einstellungen" Click="SettingsNav_Click" Style="{StaticResource CompactButton}" FontSize="14" Padding="11,4"/></StackPanel></Border>
  <Grid Grid.Row="2" Margin="18,8">
   <Grid x:Name="OverviewPage">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition x:Name="MetricsRow" Height="88"/><RowDefinition Height="*"/><RowDefinition x:Name="DevicesRow" Height="202"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock x:Name="HeadlineText" Text="Spielen. Reden. Nebenbei laden." FontSize="{DynamicResource UiMetricFontSize}" FontWeight="SemiBold"/><TextBlock x:Name="DetailText" Text="Dein Netzwerk wird automatisch abgestimmt." Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="ProtectionStatusText" Text="NETZWERKSCHUTZ · STATUS WIRD ERMITTELT" Style="{StaticResource Caption}" Foreground="{StaticResource Accent}" FontSize="11" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0"><TextBlock x:Name="QosStatusText" Text="Priorisierung wird geprüft" Foreground="{StaticResource Accent}" FontSize="11"/><TextBlock x:Name="QosDetailText" Text="Spiele und Sprachchat bleiben frei." Style="{StaticResource Caption}" FontSize="11" TextWrapping="Wrap"/></StackPanel>
    </Grid>
    <UniformGrid x:Name="StatusGrid" Grid.Row="1" Columns="4" Margin="0,0,0,8">
     <Border Style="{StaticResource Card}" Padding="10,7" Margin="0,0,8,0"><StackPanel><TextBlock Text="DOWNLOAD · PC" Style="{StaticResource Caption}"/><TextBlock x:Name="DownText" Text="— Mbps" FontSize="{DynamicResource UiMetricFontSize}" FontWeight="SemiBold" Margin="0,2"/><TextBlock x:Name="DownCaption" Text="Gesamter Empfang" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
     <Border Style="{StaticResource Card}" Padding="10,7" Margin="0,0,8,0"><StackPanel><TextBlock Text="UPLOAD · PC" Style="{StaticResource Caption}"/><TextBlock x:Name="UpText" Text="— Mbps" FontSize="{DynamicResource UiMetricFontSize}" FontWeight="SemiBold" Margin="0,2"/><TextBlock x:Name="UpCaption" Text="Gesamter Versand" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
     <Border Style="{StaticResource Card}" Padding="10,7" Margin="0,0,8,0"><StackPanel><TextBlock Text="DOWNLOADBUDGET" Style="{StaticResource Caption}"/><TextBlock x:Name="LimitText" Text="Kein Limit" FontSize="{DynamicResource UiMetricFontSize}" FontWeight="SemiBold" Margin="0,2"/><TextBlock x:Name="LimitReasonText" Text="Für große Downloads" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" AutomationProperties.Name="Grund für das Downloadlimit"/></StackPanel></Border>
     <Border Style="{StaticResource Card}" Padding="10,7"><StackPanel><TextBlock Text="NETZWERKSCHUTZ" Style="{StaticResource Caption}"/><TextBlock x:Name="DriverText" Text="WIRD GEPRÜFT" FontSize="{DynamicResource UiSectionFontSize}" FontWeight="SemiBold" Margin="0,5,0,3" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="DriverDetail" Text="Verfügbarkeit wird geprüft …" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></StackPanel></Border>
    </UniformGrid>
    <Grid x:Name="PingLayout" Grid.Row="2" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="1.7*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border x:Name="ChartPanel" Style="{StaticResource Card}" Padding="10,6" Margin="0,0,8,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel LastChildFill="False"><TextBlock Text="PING-VERLAUF" FontWeight="SemiBold"/><TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}"><Run Text="ROUTER" Foreground="{StaticResource Accent}"/><Run Text=" / "/><Run Text="INTERNET" Foreground="#E2A0A7"/></TextBlock></DockPanel>
      <TextBlock x:Name="HistoryHoverText" Grid.Row="1" Text="Mit der Maus Zeit und Messwerte ansehen" Style="{StaticResource Caption}" Margin="0,3,0,4" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
      <Grid x:Name="HistoryPlot" Grid.Row="2" ClipToBounds="True" MinHeight="50"><Canvas x:Name="HistoryCanvas" Background="#0B0C10" SizeChanged="HistoryCanvas_SizeChanged" MouseMove="HistoryCanvas_MouseMove" MouseLeave="HistoryCanvas_MouseLeave"/><Canvas x:Name="HistoryHoverCanvas" IsHitTestVisible="False"/></Grid>
      <TextBlock x:Name="HistoryCompare" Grid.Row="3" Text="Noch keine Vergleichsmessungen." Style="{StaticResource Caption}" FontSize="11" Margin="0,5,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
     </Grid></Border>
     <Border x:Name="PingPanel" Grid.Column="1" Style="{StaticResource Card}" Padding="10,6"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="VERBINDUNGSQUALITÄT" FontWeight="SemiBold"/>
      <Grid Grid.Row="1" Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
       <StackPanel Margin="0,0,8,0"><TextBlock Text="ROUTER" Style="{StaticResource Caption}"/><TextBlock x:Name="RouterPing" Text="— ms" FontSize="{DynamicResource UiMetricFontSize}"/><TextBlock x:Name="RouterStats" Text="Schwankung —" Style="{StaticResource Caption}" FontSize="11"/><TextBlock x:Name="RouterTarget" Text="Ziel wird ermittelt" Style="{StaticResource Caption}" FontSize="11"/></StackPanel>
       <StackPanel Grid.Column="1"><TextBlock Text="INTERNET" Style="{StaticResource Caption}"/><TextBlock x:Name="ExternalPing" Text="— ms" FontSize="{DynamicResource UiMetricFontSize}"/><TextBlock x:Name="ExternalStats" Text="Schwankung —" Style="{StaticResource Caption}" FontSize="11"/><TextBlock x:Name="ExternalTarget" Text="1.1.1.1" Style="{StaticResource Caption}" FontSize="11"/></StackPanel>
      </Grid>

     </Grid></Border>
    </Grid>
    <Border Grid.Row="3" Style="{StaticResource Card}" Padding="10,8"><Grid><Grid.RowDefinitions><RowDefinition Height="26"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="VERBUNDENE PCs" FontWeight="SemiBold"/><TextBlock x:Name="DeviceCount" Text="0 GERÄTE" Style="{StaticResource Caption}" Margin="12,2,0,0"/><Button x:Name="NetworkHelpButton" Content="Netzwerk prüfen" Click="NetworkHelp_Click" Visibility="Collapsed" Padding="8,2" Margin="12,0,0,0" FontSize="11"/></StackPanel><TextBlock x:Name="DevicesPageText" Grid.Column="1" Text="Seite 1 / 1" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0"/><StackPanel Grid.Column="2" Orientation="Horizontal"><Button x:Name="PreviousDevicesButton" Content="←" ToolTip="Vorherige PCs" Click="PreviousDevices_Click" Padding="9,2" Margin="0,0,4,0"/><Button x:Name="NextDevicesButton" Content="→" ToolTip="Weitere PCs" Click="NextDevices_Click" Padding="9,2" Margin="0"/></StackPanel></Grid>
     <TextBlock x:Name="SharedBudgetText" Grid.Row="1" Text="Alle DYNEX-PCs teilen sich das Downloadbudget." Foreground="{StaticResource Accent}" FontSize="{DynamicResource UiSmallFontSize}" Margin="0,3,0,2" MaxHeight="34" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
     <TextBlock x:Name="CoordinationText" Grid.Row="2" Text="Spiele und Sprachchat umgehen die Downloadwarteschlange." Style="{StaticResource Caption}" Margin="0,0,0,6" MaxHeight="34" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
     <DataGrid x:Name="DeviceGrid" Grid.Row="3" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False" CanUserResizeColumns="False" CanUserSortColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="#111318" Foreground="#E6E6E8" BorderThickness="0" RowBackground="#111318" AlternatingRowBackground="#15171D" BorderBrush="#292B33" RowHeight="29" ColumnHeaderHeight="27" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <DataGrid.Resources><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="Padding" Value="5,3"/></Style><Style x:Key="DeviceCell" TargetType="TextBlock"><Setter Property="FontSize" Value="{DynamicResource UiSmallFontSize}"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="7,2"/><Setter Property="TextWrapping" Value="NoWrap"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/></Style><Style x:Key="DeviceRateCell" TargetType="TextBlock" BasedOn="{StaticResource DeviceCell}"><Setter Property="TextAlignment" Value="Right"/><Setter Property="FontWeight" Value="SemiBold"/></Style></DataGrid.Resources>
      <DataGrid.Columns><DataGridTextColumn Header="GERÄT" Binding="{Binding Name}" Width="*" MinWidth="140" ElementStyle="{StaticResource DeviceCell}"/><DataGridTextColumn Header="ADRESSE" Binding="{Binding Address}" Width="105" ElementStyle="{StaticResource DeviceCell}"/><DataGridTextColumn Header="LÄDT GERADE" Binding="{Binding TopProgram, TargetNullValue=—}" Width="110" ElementStyle="{StaticResource DeviceCell}"/><DataGridTextColumn Header="STATUS" Binding="{Binding State}" Width="105" ElementStyle="{StaticResource DeviceCell}"/><DataGridTextColumn Header="↓ DOWNLOAD" Binding="{Binding DownloadMbps, StringFormat={}{0:0.0} Mbps, TargetNullValue=—}" Width="115" ElementStyle="{StaticResource DeviceRateCell}"/><DataGridTextColumn Header="↑ UPLOAD" Binding="{Binding UploadMbps, StringFormat={}{0:0.0} Mbps, TargetNullValue=—}" Width="110" ElementStyle="{StaticResource DeviceRateCell}"/><DataGridTextColumn Header="LIMIT" Binding="{Binding LimitMbps, StringFormat={}{0:0.0} Mbps, TargetNullValue=—}" Width="95" ElementStyle="{StaticResource DeviceCell}"/></DataGrid.Columns>
     </DataGrid>
    </Grid></Border>
   </Grid>
   <Grid x:Name="SettingsPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/><RowDefinition Height="48"/></Grid.RowDefinitions>
    <StackPanel x:Name="SettingsSectionsNav" Orientation="Horizontal" VerticalAlignment="Top"><Button Content="Allgemein" Tag="general" Click="SettingsSection_Click" Style="{StaticResource CompactButton}"/><Button Content="Spiele" Tag="games" Click="SettingsSection_Click" Style="{StaticResource CompactButton}"/><Button Content="Netzwerk" Tag="network" Click="SettingsSection_Click" Style="{StaticResource CompactButton}"/><Button Content="Planung" Tag="schedule" Click="SettingsSection_Click" Style="{StaticResource CompactButton}"/><Button Content="Analyse" Tag="analysis" Click="SettingsSection_Click" Style="{StaticResource CompactButton}"/><Button Content="Updates" Tag="updates" Click="SettingsSection_Click" Style="{StaticResource CompactButton}"/></StackPanel>
    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18"><Grid>
     <Grid x:Name="GeneralSettingsSection"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="DEIN INTERNETANSCHLUSS" Style="{StaticResource SectionTitle}"/><TextBlock Text="Internetgeschwindigkeit (Mbit/s)" Style="{StaticResource Caption}"/><StackPanel Orientation="Horizontal" Margin="0,6,0,0"><TextBox x:Name="CapacityBox" Width="120" IsReadOnly="True" Margin="0,0,8,0" VerticalContentAlignment="Center" ToolTip="Wird automatisch per Speedtest ermittelt"/><Button x:Name="SpeedTestButton" Content="Speedtest starten" Click="SpeedTest_Click" Style="{StaticResource CompactButton}"/></StackPanel><ProgressBar x:Name="SpeedTestProgress" IsIndeterminate="True" Height="3" Foreground="{StaticResource Accent}" Background="{StaticResource Line}" Margin="0,7,0,0" Visibility="Collapsed"/><TextBlock x:Name="SpeedTestHint" Style="{StaticResource Caption}" Margin="0,7,0,6"/><CheckBox x:Name="AutoStartCheck" Content="Mit Windows starten" Style="{StaticResource WrappedCheck}"/><CheckBox x:Name="NotificationsCheck" Content="Benachrichtigungen bei Verbindung und Limit" Style="{StaticResource WrappedCheck}"/><CheckBox x:Name="PingAlarmCheck" Content="Ping-Alarm beim Spielen (mit vermuteter Ursache)" Style="{StaticResource WrappedCheck}"/>
       <TextBlock Text="Download-Obergrenze beim Spielen (Mbps)" Style="{StaticResource FieldLabel}"/><StackPanel Orientation="Horizontal"><TextBox x:Name="ManualLimitBox" Width="82" Margin="0,0,8,0" ToolTip="Gilt nur, wenn auf diesem oder einem verbundenen PC ein Spiel im Fokus ist. Leer = automatisch."/><Button Content="Speichern" Click="ManualLimit_Click" Style="{StaticResource CompactButton}"/><Button Content="Aufheben" Click="ClearLimit_Click" Style="{StaticResource CompactButton}"/></StackPanel><CheckBox x:Name="UploadLimitCheck" Content="Große Uploads anderer Programme beim Spielen begrenzen" Style="{StaticResource WrappedCheck}" ToolTip="Cloud-Sync, Backups, Datei-Uploads. Spiele, Sprachchat und Bestätigungspakete von Downloads bleiben immer frei."/><TextBlock Text="Upload-Obergrenze beim Spielen (Mbps, leer = automatisch)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ManualUploadBox" Width="82" HorizontalAlignment="Left"/><TextBlock Text="Profil" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="ProfileCombo" Width="200" HorizontalAlignment="Left" SelectionChanged="ProfileCombo_SelectionChanged" ToolTip="Legt fest, wie viel der Leitung große Downloads beim Spielen nutzen dürfen."><ComboBoxItem Content="Turnier (40 % für Downloads)" Tag="Turnier"/><ComboBoxItem Content="Standard (65 %)" Tag="Standard"/><ComboBoxItem Content="Entspannt (85 %)" Tag="Entspannt"/></ComboBox><TextBlock Text="Anteil dieses PCs am gemeinsamen Budget" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="PriorityCombo" Width="200" HorizontalAlignment="Left" SelectionChanged="PriorityCombo_SelectionChanged" ToolTip="Wirkt nur, wenn alle verbundenen PCs DYNEX 1.0.6 oder neuer nutzen; sonst gleiche Anteile."><ComboBoxItem Content="Niedrig (halber Anteil)" Tag="0.5"/><ComboBoxItem Content="Normal" Tag="1"/><ComboBoxItem Content="Hoch (doppelter Anteil)" Tag="2"/></ComboBox>
      </StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="SPIELE &amp; SPRACHCHAT" Style="{StaticResource SectionTitle}"/><CheckBox x:Name="DriverCheck" Content="Beim Spielen priorisieren und große Downloads begrenzen" Style="{StaticResource WrappedCheck}"/><Button x:Name="SetupButton" Content="Downloadbegrenzung einrichten" Click="Setup_Click" Style="{StaticResource CompactButton}" HorizontalAlignment="Left" Background="{StaticResource DeepRed}" BorderBrush="{StaticResource DeepRed}" Margin="0,7,0,0"/><TextBlock x:Name="SetupHint" Text="Windows bestätigt das Einschalten." Style="{StaticResource Caption}" Margin="0,8,0,16"/><TextBlock Text="Während Gaming teilt DYNEX das Downloadbudget zwischen deinen PCs auf und priorisiert Spiele und Sprachchat. Sprachchat allein aktiviert den Filter nicht." Style="{StaticResource Caption}"/><StackPanel Orientation="Horizontal" Margin="0,18,0,0"><Button Content="Diagnose exportieren" Click="Diagnostics_Click" Style="{StaticResource CompactButton}"/><Button Content="Einstellungen sichern" Click="ExportSettings_Click" Style="{StaticResource CompactButton}"/><Button Content="Wiederherstellen" Click="ImportSettings_Click" Style="{StaticResource CompactButton}"/></StackPanel></StackPanel>
     </Grid>
     <Grid x:Name="GamesSettingsSection" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="SPIELERKENNUNG" Style="{StaticResource SectionTitle}"/><TextBlock Text="Downloads werden nur begrenzt, wenn auf einem DYNEX-PC ein Spiel im Vordergrund ist. Wallpaper Engine bleibt ausgeschlossen." Style="{StaticResource Caption}" Margin="0,0,0,12"/><ComboBox x:Name="ModeCombo" SelectionChanged="ModeCombo_SelectionChanged"><ComboBoxItem Content="Nur bei Spiel im Fokus" Tag="Auto"/><ComboBoxItem Content="Fokus-Erkennung aus" Tag="Off"/></ComboBox><TextBlock x:Name="GameText" Text="Kein Spiel erkannt" Style="{StaticResource Caption}" Margin="0,8,0,0"/><TextBlock Text="Beim Wechsel auf den Desktop oder zu Discord fällt das Limit weg, sofern kein anderer PC ein Spiel im Fokus hat. Ein Spielmenü im Vordergrund zählt ebenfalls." Style="{StaticResource Caption}" Margin="0,18,0,0"/><TextBlock Text="Schon ab Spielstart begrenzen (Prozessnamen, z. B. VALORANT-Win64-Shipping)" Style="{StaticResource FieldLabel}" ToolTip="Diese Spiele zählen schon beim Laden und in der Warteschlange, auch ohne Fokus."/><TextBox x:Name="EarlyGamesBox"/></StackPanel>
      <Grid x:Name="AdvancedExpander" Grid.Column="2"><StackPanel><TextBlock Text="FEHLENDES SPIEL ERGÄNZEN" Style="{StaticResource SectionTitle}"/><TextBlock Text="Spiel starten, laufendes Programm auswählen und hinzufügen. Anschließend Einstellungen speichern." Style="{StaticResource Caption}" Margin="0,0,0,10"/><ComboBox x:Name="RunningProcessesBox" HorizontalContentAlignment="Stretch" IsTextSearchEnabled="True" DropDownOpened="RunningProcesses_DropDownOpened" SelectionChanged="RunningProcesses_SelectionChanged" ToolTip="Laufendes Programm auswählen" AutomationProperties.Name="Laufende Programme zur Spielerkennung"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button x:Name="AddProcessButton" Content="Hinzufügen" IsEnabled="False" Click="AddProcess_Click" Style="{StaticResource CompactButton}" Background="{StaticResource DeepRed}" BorderBrush="{StaticResource DeepRed}"/><Button x:Name="RefreshProcessesButton" Content="Liste aktualisieren" Click="RefreshProcesses_Click" Style="{StaticResource CompactButton}"/></StackPanel><TextBlock x:Name="ProcessPickerHint" Text="Dropdown öffnen, um laufende Programme zu laden." Style="{StaticResource Caption}" Margin="0,6,0,3"/><TextBlock Text="Zusätzliche Prozessnamen (mit Semikolon getrennt)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ProcessesBox" Height="56" TextWrapping="Wrap" VerticalContentAlignment="Top"/></StackPanel></Grid>
     </Grid>
     <Grid x:Name="NetworkSettingsSection" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="DEINE PCs VERBINDEN" Style="{StaticResource SectionTitle}"/><CheckBox x:Name="AutoConnectCheck" Content="PCs im selben privaten Netzwerk automatisch verbinden" Style="{StaticResource WrappedCheck}"/><TextBlock Text="DYNEX muss auf jedem PC laufen. Das eigene Heimnetz in Windows auf Privat einstellen; dann ist kein Verbindungscode nötig." Style="{StaticResource Caption}" Margin="0,2,0,12"/><TextBlock Text="Manuelle Gruppe (optional)" Style="{StaticResource FieldLabel}"/><TextBlock Text="Anzeigen oder Kopieren aktiviert die manuelle Gruppe auf diesem PC. Den Code auf den anderen PCs importieren. Alle beteiligten PCs müssen denselben Modus verwenden." Style="{StaticResource Caption}" Margin="0,0,0,7"/><TextBox x:Name="PairingBox" IsReadOnly="True" FontFamily="Consolas"/><StackPanel Orientation="Horizontal" Margin="0,7,0,0"><Button Content="Anzeigen" Click="RevealCode_Click" Style="{StaticResource CompactButton}"/><Button Content="Kopieren" Click="CopyCode_Click" Style="{StaticResource CompactButton}"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,7,0,0"><Button Content="Einfügen" Click="PasteCode_Click" Style="{StaticResource CompactButton}"/><Button Content="Code importieren" Click="ImportCode_Click" Style="{StaticResource CompactButton}"/></StackPanel><TextBlock x:Name="PairFingerprint" Text="Noch keine Gruppe gekoppelt" Style="{StaticResource Caption}" Margin="0,8,0,0"/></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="VERBINDUNG &amp; MESSZIELE" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="NetworkHelpText" Style="{StaticResource Caption}" Margin="0,0,0,6"/><StackPanel Orientation="Horizontal"><Button x:Name="CheckConnectionButton" Content="Verbindung prüfen" Click="NetworkHelp_Click" Style="{StaticResource CompactButton}" Margin="0,0,6,10"/><Button x:Name="WindowsNetworkButton" Content="Windows-Netzwerk öffnen" Click="WindowsNetwork_Click" Style="{StaticResource CompactButton}" HorizontalAlignment="Left" Margin="0,0,0,10"/></StackPanel><TextBlock Text="Direkte Geräteadressen (optional, private IPv4)" Style="{StaticResource Caption}"/><TextBox x:Name="PeersBox" AcceptsReturn="True" Height="56" Margin="0,5,0,0"/><TextBlock Text="Router-Pingziel (leer = automatisch)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="RouterBox"/><TextBlock Text="Internet-Pingziel (Vergleichswert)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ExternalBox"/></StackPanel>
     </Grid>
     <Grid x:Name="ScheduleSettingsSection" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="NACHTS OHNE LIMITS" Style="{StaticResource SectionTitle}"/><CheckBox x:Name="NightFreeCheck" Content="In diesem Zeitraum nie begrenzen" Style="{StaticResource WrappedCheck}"/><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><TextBlock Text="von" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="NightFromBox" Width="64"/><TextBlock Text="bis" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="10,0,6,0"/><TextBox x:Name="NightToBox" Width="64"/><TextBlock Text="Uhr" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="6,0,0,0"/></StackPanel><TextBlock Text="Große Downloads laufen dann mit voller Geschwindigkeit, auch wenn jemand spielt – ideal für Updates über Nacht." Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap"/></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="WOCHENENDE" Style="{StaticResource SectionTitle}"/><TextBlock Text="Profil am Samstag und Sonntag" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="WeekendProfileCombo" Width="220" HorizontalAlignment="Left"><ComboBoxItem Content="Wie unter Allgemein" Tag=""/><ComboBoxItem Content="Turnier (40 %)" Tag="Turnier"/><ComboBoxItem Content="Standard (65 %)" Tag="Standard"/><ComboBoxItem Content="Entspannt (85 %)" Tag="Entspannt"/></ComboBox><TextBlock x:Name="ScheduleStatusText" Style="{StaticResource Caption}" Margin="0,12,0,0" TextWrapping="Wrap"/><TextBlock Text="Änderungen mit „Einstellungen speichern“ übernehmen." Style="{StaticResource Caption}" Margin="0,8,0,0"/></StackPanel>
     </Grid>
