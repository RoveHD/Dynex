              </DataGrid>
              <TextBlock x:Name="OverviewDevicesEmpty" Text="Noch keine Gerätedaten verfügbar. DYNEX auf weiteren PCs starten und verbinden." Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="14,0" IsHitTestVisible="False" />
            </Grid>
          </Grid>
        </Border>
      </Grid>
      <Grid x:Name="DevicesPage" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel x:Name="DevicesPageHeader" Margin="0,0,0,10">
