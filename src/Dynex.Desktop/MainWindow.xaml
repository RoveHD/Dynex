  <TextBlock x:Name="CoordinationText" Text="Spiel- und Sprachchatpakete umgehen die Downloadwarteschlange." Foreground="{StaticResource Muted}" FontSize="{DynamicResource UiSmallFontSize}" TextWrapping="Wrap" Margin="0,0,0,12"/>
