ricFontSize}" FontWeight="SemiBold" Margin="0,7"/><TextBlock x:Name="DriverDetail" Text="Verfügbarkeit wird geprüft …" Foreground="{StaticResource Muted}" FontSize="{DynamicResource UiSmallFontSize}"/><TextBlock x:Name="QosStatusText" Text="QoS-Status · noch keine Bestätigung" Foreground="{StaticResource Accent}" FontSize="{DynamicResource UiSmallFontSize}" FontWeight="SemiBold" Margin="0,10,0,0"/><TextBlock x:Name="QosDetailText" Text="Spiele &amp; Sprachchat · Router muss QoS unterstützen." Foreground="{StaticResource Muted}" FontSize="{DynamicResource UiSmallFontSize}" Margin="0,3,0,0"/></StackPanel></Border></UniformGrid>
