                  <DataGridTextColumn Header="↓ DOWNLOAD" Binding="{Binding DownloadMbps, StringFormat={}{0:0.0} Mbps, TargetNullValue=—}" Width="1.2*" MinWidth="88" ElementStyle="{StaticResource OverviewDeviceRateCell}" />
                  <DataGridTextColumn Header="↑ UPLOAD" Binding="{Binding UploadMbps, StringFormat={}{0:0.0} Mbps, TargetNullValue=—}" Width="1.2*" MinWidth="82" ElementStyle="{StaticResource OverviewDeviceRateCell}" />
