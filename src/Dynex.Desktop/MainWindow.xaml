 </StackPanel>
</Border><Grid x:Name="SettingsLayout"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="0.95*"/></Grid.ColumnDefinitions><Border x:Name="SettingsPanel" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="16" Margin="0,0,8,0"><StackPanel><TextBlock Text="EINSTELLUNGEN" Style="{StaticResource SectionTitle}"/><TextBlock Text="Internetgeschwindigkeit (Mbit/s)" Foreground="{StaticResource Muted}" FontSize="{DynamicResource UiSmallFontSize}"/><WrapPanel Margin="0,4,0,0"><TextBox x:Name="CapacityBox" Width="140" IsReadOnly="True" VerticalContentAlignment="Center" ToolTip="Wird automatisch per Download-Speedtest ermittelt" Margin="0,0,8,0"/><Button x:Name="SpeedTestButton" Content="Speedtest starten" Click="SpeedTest_Click"/></WrapPanel><ProgressBar x:Name="SpeedTestProgress" IsIndeterminate="True" Height="3" Foreground="{StaticResource Accent}" Background="{StaticResource Line}" Margin="0,9,0,0" Visibility="Collapsed"/><TextBlock x:Name="SpeedTestHint" Foreground="{StaticResource Muted}" FontSize="{DynamicResource UiSmallFontSize}" Margin="0,7,0,10"/><CheckBox x:Name="AutoConnectCheck" Content="PCs im selben privaten Netzwerk automatisch verbinden"/><TextBlock Text="DYNEX muss auf jedem PC laufen. In deinem privaten Heimnetz ist kein Verbindungscode nötig." Foreground="{StaticResource Muted}" FontSize="{DynamicResource UiSmallFontSize}" Margin="0,0,0,10"/><CheckBox x:Name="AutoStartCheck" Content="Mit Windows starten"/><Button x:Name="SetupButton" Content="Downloadbegrenzung einrichten" Click="Setup_Click" HorizontalAlignment="Left" Background="{StaticResource DeepRed}" BorderBrush="{StaticResource DeepRed}"/><CheckBox x:Name="DriverCheck" Content="Spiele &amp; Sprachchat priorisieren und große Downloads begrenzen"/><TextBlock x:Name="SetupHin