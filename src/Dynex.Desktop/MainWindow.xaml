ze}" Margin="0,7,0,0"/></StackPanel></Expander><Expander Header="Manuelle Gruppe (optional)" Foreground="#F2F2F4" Background="Transparent" Margin="0,4,0,8"><StackPanel><TextBlock Text="Den gleichen Gruppencode nur mit PCs teilen, denen du vertraust." Foreground="{StaticResource Muted}" FontSize="{DynamicResource UiSmallFontSize}" Margin="0,8,0,0"/><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="PairingBox" IsReadOnly="True" FontFamily="Consolas"/><Button Grid.Column="1" Content="Anzeigen" Click="RevealCode_Click" Margin="8,0,0,0"/><Button Grid.Column="2" Content="Kopieren" Click="CopyCode_Click" Margin="8,0,0,0"/></Grid><WrapPanel Margin="0,8,0,8"><Button Content="Einfügen" Click="PasteCode_Click"/><Button Content="Code importieren" Click="ImportCode_Click" Background="{StaticResource DeepRed}" BorderBrush="{StaticResource DeepRed}"/><TextBlock x:Name="PairFingerprint" Text="Noch keine Gruppe gekoppelt" Foreground="{StaticResource Muted}" VerticalAlignment="Center" FontSize="{DynamicResource UiSmallFontSize}" Margin="0,6,0,6"/></WrapPanel></StackPanel></Expander><Expander x:Name="AdvancedExpander" Header="Erweitert" Foreground="#F2F2F4" Background="Transparent" Margin="0,4,0,8"><StackPanel>
