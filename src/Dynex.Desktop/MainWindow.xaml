        <Border Style="{StaticResource Card}" MaxWidth="560" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="22,18">
          <StackPanel>
            <TextBlock Text="DYNEX EINRICHTEN" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="Drei Punkte, dann arbeitet DYNEX automatisch. Der Stand wird live geprüft." Style="{StaticResource Caption}" Margin="0,0,0,12" TextWrapping="Wrap" />
            <TextBlock x:Name="GuideNetworkText" Text="1 · Netzwerk wird geprüft …" TextWrapping="Wrap" Margin="0,0,0,8" />
            <TextBlock x:Name="GuidePeerText" Text="2 · Andere PCs werden gesucht …" TextWrapping="Wrap" Margin="0,0,0,8" />
            <TextBlock x:Name="GuideSpeedText" Text="3 · Speedtest wird geprüft …" TextWrapping="Wrap" Margin="0,0,0,14" />
            <StackPanel Orientation="Horizontal">
              <Button Content="Windows-Netzwerk öffnen" Click="WindowsNetwork_Click" Style="{StaticResource CompactButton}" />
              <Button Content="Speedtest starten" Click="SpeedTest_Click" Style="{StaticResource CompactButton}" />
              <Button x:Name="GuideDoneButton" Content="Später" Click="GuideDone_Click" Style="{StaticResource CompactButton}" Background="{StaticResource DeepRed}" BorderBrush="{StaticResource DeepRed}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Border>
    </Grid>
    <Border Grid.Row="2" Background="#0C0D11" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Grid.ColumnSpan="2">
      <Grid Margin="18,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="ErrorText" Foreground="#FF7882" FontSize="11" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
        <TextBlock x:Name="NetworkStatus" Grid.Column="1" Text="Netzwerk wird ermittelt" Style="{StaticResource Caption}" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" HorizontalAlignment="Right" />
      </Grid>
    </Border>
  </Grid>
</Window>
