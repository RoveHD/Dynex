<Window x:Class="Dynex.Desktop.UsageHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Datenverbrauch" Width="820" Height="580" MinWidth="650" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="#10151D" Foreground="#E7EDF5">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="DATENVERBRAUCH" Foreground="#75D5C1" FontSize="12" FontWeight="Bold"/>
      <TextBlock Text="Geschätzter Verbrauch je PC" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,16"/>
    </StackPanel>
    <DockPanel Grid.Row="1" Margin="0,0,0,14">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
        <Button x:Name="TodayButton" Content="Heute" Padding="14,7" Margin="0,0,8,0" Click="Today_Click"/>
        <Button x:Name="WeekButton" Content="7 Tage" Padding="14,7" Click="Week_Click"/>
      </StackPanel>
      <DatePicker x:Name="DatePicker" Width="150" HorizontalAlignment="Right" Foreground="#111318" SelectedDateChanged="DatePicker_Changed"/>
    </DockPanel>
    <DataGrid x:Name="UsageGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
              HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="#171E28" Foreground="#E7EDF5"
              BorderBrush="#303B48" RowBackground="#171E28" AlternatingRowBackground="#1D2632" SelectionMode="Single">
      <DataGrid.Columns>
        <DataGridTextColumn Header="PC" Binding="{Binding PcName}" Width="2*" MinWidth="130"/>
        <DataGridTextColumn Header="DOWNLOAD · GB" Binding="{Binding DownloadText}" Width="*" MinWidth="115"/>
        <DataGridTextColumn Header="UPLOAD · GB" Binding="{Binding UploadText}" Width="*" MinWidth="105"/>
        <DataGridTextColumn Header="LÜCKEN ↓ / ↑" Binding="{Binding Gaps}" Width="1.3*" MinWidth="130"/>
      </DataGrid.Columns>
    </DataGrid>
    <TextBlock x:Name="InfoText" Grid.Row="3" Margin="0,14,0,0" Foreground="#AAB6C5" TextWrapping="Wrap"/>
  </Grid>
</Window>
