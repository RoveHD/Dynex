<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Dynex.Android</RootNamespace>
    <ApplicationId>de.dynex.mobile</ApplicationId>
    <ApplicationTitle>DYNEX</ApplicationTitle>
    <Version>1.0.12</Version>
    <ApplicationVersion>10012</ApplicationVersion>
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidUseAssemblyStore>true</AndroidUseAssemblyStore>
    <AndroidLinkMode>None</AndroidLinkMode>
    <RunAOTCompilation>false</RunAOTCompilation>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <!-- Standalone APK tests must not load the soft-debugger component: with the
       pinned Android 35.0.78 runtime it deadlocks managed threads without an IDE.
       The DEBUG self-test remains available, using the normal runtime. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <AndroidUseDebugRuntime>false</AndroidUseDebugRuntime>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>None</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Dynex.Core/Dynex.Core.csproj" />
    <ProjectReference Include="../Dynex.Mobile/Dynex.Mobile.csproj" />
    <AndroidNativeLibrary Include="../../artifacts/android-dependencies/native/arm64-v8a/libhev-socks5-tunnel.so" Abi="arm64-v8a" />
    <AndroidNativeLibrary Include="../../artifacts/android-dependencies/native/x86_64/libhev-socks5-tunnel.so" Abi="x86_64" />
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <Compile Include="../../tests/Dynex.MobileProxy.Tests/MobileProxyChecks.cs" Link="Tests/MobileProxyChecks.cs" />
    <Compile Include="../../tests/Dynex.Core.Tests/AutoLanClockTests.cs" Link="Tests/AutoLanClockTests.cs" />
  </ItemGroup>
  <Target Name="RequireTunnelDependency" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('../../artifacts/android-dependencies/native/arm64-v8a/libhev-socks5-tunnel.so')" Text="Die geprüfte Tunnelbibliothek fehlt. Zuerst scripts/prepare-android.ps1 ausführen." />
  </Target>
</Project>
